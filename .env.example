# ============================================================================
# ZynderJhnzV1Beta - Environment Variables
# ============================================================================
# Salin file ini menjadi .env dan isi nilai sesuai kebutuhan deployment.
# JANGAN jamais commit file .env ke repositori publik. File .env sudah
# termasuk dalam .gitignore.

# Firebase Project Configuration (Admin / Server side)
# Service Account credentials - HANYA di backend, JANGAN sampai ke frontend
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Telegram Bot (HANYA di backend)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Qiospay Gateway
QIOSPAY_API_KEY=
QIOSPAY_SECRET_KEY=

# Admin Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Aplikasi
APP_URL=
NODE_ENV=production
PORT=3000

# Firebase Web Config (boleh digunakan frontend, bukan pengganti sistem keamanan)
# Nilai ini diisi otomatis dari firebase-applet-config.json saat build
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
